{
  "name": "flux-purr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "node scripts/build-thermal-tuning-wasm.mjs",
    "prebuild": "bun run build:wasm",
    "build": "tsc -b && vite build",
    "prebuild:demo": "bun run build:wasm",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "pretypecheck": "bun run build:wasm",
    "typecheck": "tsc -b --pretty false",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "bun run check",
    "preview": "vite preview",
    "storybook": "storybook dev --no-open",
    "prebuild-storybook": "bun run build:wasm",
    "build-storybook": "storybook build",
    "pretest:unit": "bun run build:wasm",
    "test:unit": "vitest --config vitest.unit.config.ts --run",
    "pretest:storybook": "bun run build:wasm",
    "test:storybook": "vitest --project=storybook --run",
    "storybook:ci": "bun run build-storybook",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:public-demo": "playwright test --config playwright.public-demo.config.ts --pass-with-no-tests"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-virtual": "^3.13.25",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esptool-js": "^0.6.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.576.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simplebar-react": "^3.3.2",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.2.13",
    "@storybook/addon-docs": "^10.2.13",
    "@storybook/addon-onboarding": "^10.2.13",
    "@storybook/addon-vitest": "^10.2.13",
    "@storybook/react-vite": "^10.2.13",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "^1.168.32",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.2.13",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "shadcn": "^3.8.5",
    "storybook": "^10.2.13",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
