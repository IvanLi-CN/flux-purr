{
  "name": "flux-purr-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "typecheck": "tsc -b --pretty false",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "bun run check",
    "preview": "vite preview",
    "storybook": "storybook dev --no-open",
    "build-storybook": "storybook build",
    "test:unit": "vitest --config vitest.unit.config.ts --run",
    "test:storybook": "vitest --project=storybook --run",
    "storybook:ci": "bun run build-storybook",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:public-demo": "playwright test --config playwright.public-demo.config.ts --pass-with-no-tests",
    "test:e2e:formal": "playwright test --config playwright.formal.config.ts --pass-with-no-tests"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.28",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esptool-js": "^0.7.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.81.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simplebar-react": "^3.3.2",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-onboarding": "^10.6.9",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.2",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.6.9",
    "globals": "^16.5.0",
    "playwright": "^1.65.1",
    "shadcn": "^4.23.1",
    "storybook": "^10.6.9",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
